# Cryptography Manager -- runtime configuration for the UC3 testbed.
#
# Copy to .env, restrict it (chmod 600) and fill in the placeholders. The real
# .env holds a client secret: keep it on the testbed or in protected CI/CD
# variables, never in a repository.

# ---- image ----------------------------------------------------------------
CRM_IMAGE_TAG=0.3.0
CRM_IMAGE_DIGEST=sha256:<digest of the 0.3.0 image>
# Address the host port is published on. 127.0.0.1 behind a local ingress.
CRM_BIND_ADDRESS=127.0.0.1

# ---- authentication (ILM / Keycloak) -------------------------------------
CRM_AUTH_MODE=oidc
KEYCLOAK_URL=https://<keycloak-host>
KEYCLOAK_REALM=recitals
KEYCLOAK_CLIENT_ID=recitals-cryptography-manager
# Only needed for the service's own outbound calls (client credentials).
KEYCLOAK_CLIENT_SECRET=<client secret>
# Defaults to the client ID; set only if the ILM issues a different audience.
#CRM_OIDC_AUDIENCE=recitals-cryptography-manager
# Set to skip discovery and fetch signing keys directly.
#CRM_OIDC_JWKS_URI=https://<keycloak-host>/realms/recitals/protocol/openid-connect/certs
# Each action requires crypto.<action> as a scope or client role.
CRM_OIDC_ENFORCE_PERMISSIONS=true

# ---- downstream services --------------------------------------------------
# Leave any of these empty to not forward there; the local trail is kept
# either way.
CRM_LEDGER_ENDPOINT=
CRM_CM_ENDPOINT=http://<compliance-manager-host>:8000
# Must already exist in the compliance manager.
CRM_CM_USE_CASE_ID=UC3
CRM_ILM_ENDPOINT=
CRM_FORWARD_ATTEMPTS=3

# ---- service --------------------------------------------------------------
CRM_LOG_LEVEL=INFO
# Largest accepted request body, in bytes (10 MiB).
CRM_MAX_REQUEST_BYTES=10485760
